; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fire Exits"
run/main_scene="uid://o3n2qhxv1pe8"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.8217887, 0.82178867, 0.82178867, 1)
boot_splash/image="uid://ce4ab8smdoc3t"
config/icon="res://icon.svg"

[debug]

shapes/collision/shape_color=Color(0, 0.49411765, 0.5764706, 0.7764706)

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

Exits="Exit Nodes"

[input_devices]

pointing/emulate_mouse_from_touch=false

[navigation]

2d/default_edge_connection_margin=10.0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
